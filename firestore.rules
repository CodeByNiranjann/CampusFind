rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // ITEMS
    // =========================

    match /items/{itemId} {

      // Logged-in users can search lost/found items
      allow read: if request.auth != null;

      // User can create their own item
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      // Only item owner can update/delete
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }


    // =========================
    // MATCHES
    // =========================

    match /matches/{matchId} {

      // Users involved in the match can read it
      allow read: if request.auth != null
        && (
          resource.data.lostUserId == request.auth.uid
          || resource.data.foundUserId == request.auth.uid
        );

      // A logged-in user can create a match
      // when they are one of the users involved
      allow create: if request.auth != null
        && (
          request.resource.data.lostUserId == request.auth.uid
          || request.resource.data.foundUserId == request.auth.uid
        );

      allow update, delete: if request.auth != null
        && (
          resource.data.lostUserId == request.auth.uid
          || resource.data.foundUserId == request.auth.uid
        );
    }


    // =========================
    // USERS
    // =========================

    match /users/{userId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId;

      allow update, delete: if request.auth != null
        && request.auth.uid == userId;
    }


    // =========================
    // CHATS
    // =========================

    match /chats/{chatId} {

      // Only participants can read the chat
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;


      // Only participants can create a chat
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;


      // Only participants can update the chat
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;


      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;


      // =========================
      // CHAT MESSAGES
      // =========================

      match /messages/{messageId} {

        // Only chat participants can read messages
        allow read: if request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants;


        // Only chat participants can send messages
        allow create: if request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants
          && request.resource.data.senderId == request.auth.uid;


        // Sender can update/delete their own message
        allow update, delete: if request.auth != null
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}